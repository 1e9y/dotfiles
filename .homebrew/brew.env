# Homebrew settings, read by every `brew` run regardless of shell.
# Lives at ~/.homebrew/brew.env. One KEY=value per line, no quotes:
# brew exports each line as-is, so quotes would end up in the value.

# Don't send usage analytics
HOMEBREW_NO_ANALYTICS=1

# Hide "Hide these hints with HOMEBREW_NO_ENV_HINTS" messages
HOMEBREW_NO_ENV_HINTS=1

# Install apps to ~/Applications and refuse casks without a checksum
HOMEBREW_CASK_OPTS=--require-sha --appdir=~/Applications
